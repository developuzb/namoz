# =======================================================
# Telegram Bot
# =======================================================
BOT_TOKEN=123456789:ABCdefGHIjklMNOpqrSTUvwxYZ
# Vergul bilan ajratilgan admin Telegram ID lar
ADMIN_IDS=5801216854

# =======================================================
# Vaqt sozlamalari
# =======================================================
# Har kuni post yuboriladigan vaqt (HH:MM)
DAILY_POST_TIME=06:00
# Bot timezone si
TIMEZONE=Asia/Tashkent

# =======================================================
# Database
# =======================================================
# SQLite uchun async URL
DATABASE_URL=sqlite+aiosqlite:///data/bot.db

# =======================================================
# Prayer Time Provider
# =======================================================
# Asosiy: islomapi | Zaxira: praytime
PRAYER_PROVIDER_PRIMARY=islomapi
PRAYER_PROVIDER_FALLBACK=praytime

# Provider URL lari
ISLOMAPI_BASE_URL=https://islomapi.uz
PRAYTIME_BASE_URL=https://praytime.uz

# Provider so'rovi uchun timeout (sekundlarda)
PROVIDER_TIMEOUT=15

# =======================================================
# Logging
# =======================================================
# DEBUG | INFO | WARNING | ERROR
LOG_LEVEL=INFO
LOG_FILE=logs/bot.log
# Log fayl rotatsiyasi
LOG_ROTATION=10 MB
LOG_RETENTION=30 days

# =======================================================
# Notification (DM obunachilarga)
# =======================================================
# Farz vaqtida DM ga eslatma yuborilsinmi (default)
NOTIFY_FARZ_DEFAULT=true
# Eslatma necha daqiqadan keyin o'chadi
NOTIFICATION_DELETE_AFTER=300

# =======================================================
# Qashqadaryo kunlik plakat (kirilcha)
# =======================================================
# Plakat har kuni avtomatik yuboriladigan chat/kanal ID si.
# 0 — o'chirilgan (faqat /test_namoz orqali qo'lda yuborish ishlaydi).
# Kanal/guruh uchun -100 bilan boshlanadigan ID (bot adminga qo'shilishi kerak).
NAMOZ_CHAT_ID=0
# Plakat yuborish vaqti (HH:MM, NAMOZ_TIMEZONE bo'yicha)
NAMOZ_SEND_TIME=04:00
# Timezone — odatda TIMEZONE bilan bir xil
NAMOZ_TIMEZONE=Asia/Tashkent
